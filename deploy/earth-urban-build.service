# Packs the streets and buildings of every tile with a town in it (tools/pack_planet.py), reading
# straight from Overture's bucket: a local copy (350 GB of writes) made the shared disk stall the live
# servers on 2026-10-15/16. Restartable: tiles already packed are skipped. Lowest disk and CPU priority, so the live servers keep their disk. Started by hand:
#   sudo install -m 644 deploy/earth-urban-build.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl start earth-urban-build
[Unit]
Description=earth.tj: pack the planet's streets and buildings
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Nice=19
IOSchedulingClass=idle
CPUWeight=10
MemoryMax=2500M
MemorySwapMax=0
TimeoutStartSec=infinity
Environment=EARTH_DATA=/home/ubuntu/earth-data
ExecStart=/home/ubuntu/earth-data/urban-venv/bin/python /home/ubuntu/earth-mod/tools/pack_planet.py
StandardOutput=append:/home/ubuntu/earth-data/urban-build.log
StandardError=append:/home/ubuntu/earth-data/urban-build.log
